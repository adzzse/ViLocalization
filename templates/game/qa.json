{
  "tag_names": ["br", "b", "i", "u", "s", "strong", "em", "p", "span", "font", "color", "size", "sprite", "link", "no-wrap", "action-key"],
  "protected_patterns": [
    "\\$?\\{[^{}\\r\\n]+\\}",
    "\\[[A-Za-z_][A-Za-z0-9_.]*\\]",
    "\\$[A-Za-z_][A-Za-z0-9_]*\\$",
    "\\\\[nr]"
  ],
  "ordered_patterns": ["\\[[0-9]+(?:\\.[0-9]+)?-[0-9]+(?:\\.[0-9]+)?\\]", "\\\\[A-Za-z]+\\[[^\\]\\r\\n]*\\]"],
  "preserve_newlines": true
}
